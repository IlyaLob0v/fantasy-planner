# Скопируй в .env и впиши свои значения. Файл .env в репозиторий не попадает.

# Пароль базы: длинный и случайный, например из менеджера паролей.
# Если тестовый сервер уже запускался со старым паролем guild, впиши guild
# или сотри базу командой `docker compose down -v`.
POSTGRES_PASSWORD=

# Только для сервера в интернете (docker-compose.prod.yml): домен, который смотрит на сервер.
DOMAIN=
